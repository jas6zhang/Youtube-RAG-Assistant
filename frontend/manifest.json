{
    "manifest_version": 3,
    "name": "YouTube RAG Helper",
    "version": "1.0.0",
    "host_permissions": ["http://localhost:8000/*", "https://youtube-rag-assistant-7.onrender.com/*"],
    "content_scripts": [{
        "matches": ["*://www.youtube.com/watch*"],
        "js": ["content-script.js"],
        "run_at": "document_idle",
        "css": ["content.css"]
    }],
    "description": "Ask questions about YouTube videos using AI",
    "icons": {
        "16": "icons/helper-16.png",
        "32": "icons/helper-32.png",
        "48": "icons/helper-48.png",
        "128": "icons/helper-128.png"
    }
}