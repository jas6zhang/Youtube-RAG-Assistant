# Required: your OpenAI API key (used for embeddings, Whisper, and chat).
OPENAI_API_KEY=sk-...

# Optional: gate the API. If set, requests must send a matching X-API-Key
# header (the Chrome extension's API_KEY constant must match this value).
# Leave unset to run an open/dev backend.
API_KEY=

# Optional: where ChromaDB persists its data. In production point this at a
# mounted persistent disk (e.g. /var/data/chroma_db on Render) so embeddings
# survive restarts instead of being re-computed and re-billed on every deploy.
CHROMA_DB_PATH=./chroma_db

# Optional: per-IP sliding-window rate limit (requests per window seconds).
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=60

# Optional: chat model used to answer questions.
CHAT_MODEL=gpt-5

# Optional: max transcript excerpts sent to the LLM per question. The extension
# over-fetches candidates for recall; only the top N unique ones are sent, which
# is the main lever on recurring per-question token cost. Lower = cheaper.
MAX_CONTEXT_CHUNKS=8
